# 原有 Gemini 金鑰：直接沿用 V2 設定
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# 這次新加：Dify Knowledge Base Service API Key（不是 Dify Chatbot App Key）
DIFY_API_KEY=your_dify_knowledge_base_service_api_key
# Classic Knowledge Base UUID, not document id
DIFY_DATASET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Dify Cloud 預設值，可不設定；自架才需要換
DIFY_API_BASE_URL=https://api.dify.ai/v1
